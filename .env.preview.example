# Operator reference only. These files are NOT automatically loaded by Node.
# Configure these variables ONLY on the new authenticated-preview Railway service.
PREVIEW_HOSTED=true
PREVIEW_DATA_DIR=/data/front-desk-mate-preview
PREVIEW_ACCESS_USER=reviewer
# Generate a NEW random value for each secret. No sample secret is supplied.
PREVIEW_ACCESS_PASSWORD=
SESSION_SECRET=
# Railway supplies PORT. npm run demo:preview forces development fixture mode,
# secure cookies, inactive live adapters and private paths below PREVIEW_DATA_DIR.
# Do not add production credentials, payer keys, real patient data, or device keys.
