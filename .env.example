PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DATABASE_PATH=./data/clinic.db
UPLOAD_DIR=./uploads
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SEED_DEMO=true
# Production connector is intentionally unconfigured; no payer transmission occurs.
PAYER_ADAPTER=none

# Opt in only for the seeded local fictional generated-tone workflow.
FICTIONAL_AUDIO_DEMO=false
AUDIO_DIR=./data/private-audio

# Set true only for an HTTPS hosted fictional demo; keep false for localhost.
COOKIE_SECURE=false

# Test-only adapter for bundled sample patient; forbidden in production.
FICTIONAL_CLEARINGHOUSE_DEMO=false
# Hard-disabled: setting true fails startup.
LIVE_CLEARINGHOUSE_ENABLED=false
